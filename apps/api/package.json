{
  "name": "@talus/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --external:pg-native --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@talus/db": "workspace:*",
    "@talus/game-core": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": { "esbuild": "^0.25.0", "typescript": "^5.9.0" }
}
